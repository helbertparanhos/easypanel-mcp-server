# URL do seu painel Easypanel (sem barra no final)
EASYPANEL_URL=https://seu-painel.exemplo.com

# Token de API — gere em: Easypanel > Settings > API > Generate Token
EASYPANEL_TOKEN=seu-token-api-aqui

# (Opcional) Modo de acesso. Use "readonly" para bloquear TODA escrita (mutations),
# deixando apenas inspeção/diagnóstico — ideal para conectar a um painel de produção.
# Default: full (escrita habilitada, com as confirmações CONFIRMO de sempre).
# MCP_ACCESS_MODE=readonly

# (Opcional) Desabilita a tool easypanel_raw (escape hatch que chama qualquer operação).
# Recomendado em ambientes expostos a conteúdo não confiável: reads via easypanel_raw
# podem retornar secrets de qualquer projeto e NÃO são cobertos pelo readonly.
# EASYPANEL_RAW_DISABLED=1

# (Opcional) Força a geração da API do painel em vez de auto-detectar:
#   trpc   → Easypanel ≤ 2.30
#   rpc    → Easypanel 2.31–2.32 (API interna)
#   public → Easypanel ≥ 2.33 (API pública documentada)
# Deixe comentado a menos que precise. ⚠️ Se você fixou "rpc" na v2, REMOVA:
# num painel 2.33 isso mantém o MCP na API interna, que o Easypanel declarou instável.
# EASYPANEL_API_FLAVOR=public
