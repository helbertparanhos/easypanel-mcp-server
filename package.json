{
  "name": "easypanel-mcp-server",
  "version": "2.0.1",
  "description": "MCP Server for Easypanel — full control of projects, services, deploys, env vars, logs, databases, volumes, ports, compose and server maintenance from Claude Code, Cursor and Claude Desktop. 57 tools + raw API access. Supports both API generations (Easypanel <= 2.30 tRPC and >= 2.31 RPC) with auto-detection.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "easypanel-mcp-server": "dist/index.js",
    "easypanel-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "easypanel",
    "claude",
    "claude-code",
    "cursor",
    "deployment",
    "docker",
    "model-context-protocol",
    "automation",
    "devops",
    "hosting",
    "strat-academy"
  ],
  "author": "helbertparanhos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/helbertparanhos/easypanel-mcp-server"
  },
  "homepage": "https://github.com/helbertparanhos/easypanel-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/helbertparanhos/easypanel-mcp-server/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "ws": "8.21.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
